NODE_ENV=production
PORT=3000
APP_BASE_URL=https://YOUR-DOMAIN.example
DB_PATH=./data/nvg.sqlite

# Add newly generated credentials here on your hosting provider's server-side Secrets/Environment page.
# Do not commit .env and do not put these values in index.html or browser JavaScript.
NOWPAYMENTS_API_KEY=PASTE_NEW_ROTATED_API_KEY_HERE
NOWPAYMENTS_IPN_SECRET=PASTE_NOWPAYMENTS_IPN_SECRET_HERE

# Same Supabase project used by the frontend; anon/publishable key is not a secret.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
